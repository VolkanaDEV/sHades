#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import MDApp kivymd.app.MDApp
#:import scaled ui_scale.scaled

# Every button in the client is drawn a third shorter than the height it
# would otherwise get (40dp -> 26.67dp, and so on). The factor lives in
# ui_scale.py so the KV layout and the Python-built popups stay in sync.
# This is the default; buttons with an explicit height below scale their
# own height the same way.
<MDButton>:
    height: scaled(dp(40))

<PFPEditorWidget>:
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0.4
        Ellipse:
            pos: root.crop_cx - root.crop_r, root.crop_cy - root.crop_r
            size: root.crop_r * 2, root.crop_r * 2
        Color:
            rgba: app.theme_colors['text']
        Line:
            circle: root.crop_cx, root.crop_cy, root.crop_r
            width: 2
    PassThroughImage:
        id: pfp_img
        source: root.source
        allow_stretch: False
        keep_ratio: True
        size_hint: None, None
        on_texture_size: root._size_image()

<MessageRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(8), dp(6)]
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: app.theme_colors['msg_own'] if root.is_own else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8), dp(8), dp(8), dp(8)]

    PfpImage:
        id: pfp
        size_hint: None, None
        size: dp(32), dp(32)
        source: root.avatar_source or ""
        allow_stretch: False
        keep_ratio: True

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 1
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(2)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(18)
            ClickableLabel:
                text: root.username
                target_hash: root.author_hash
                color: app.theme_colors['text'] if root.is_own else app.theme_colors['text_muted']
                bold: True
                font_size: sp(13)
                text_size: self.width, None
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                shorten: True
                on_press: app.open_profile(root.author_hash, root.username)
            Label:
                text: root.ts
                color: app.theme_colors['text_dim']
                font_size: sp(11)
                text_size: self.width, None
                size_hint_x: None
                width: dp(50)
                halign: 'right'
                valign: 'middle'

        # Embed container - holds image embeds for this message.
        # Placed directly under the username header so embeds are top-left,
        # next to the sender, and the row expands to contain them so the
        # following message lands beneath (not overlapping).
        BoxLayout:
            id: embed_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

        Label:
            id: content_lbl
            text: root.content_markup
            markup: True
            color: app.theme_colors['text']
            font_size: sp(14)
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            halign: 'left'
            valign: 'top'

    Widget:
        size_hint_x: None
        width: dp(4)

<ChannelButton>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(44)
    padding: [dp(10), 0]
    spacing: dp(4)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(20)
        Label:
            text: root.channel_name
            color: app.theme_colors['text_muted']
            font_size: sp(13)
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            size_hint_x: 1
        Label:
            id: badge
            text: str(root.badge) if root.badge else ''
            color: app.theme_colors['text']
            bold: True
            font_size: sp(12)
            size_hint_x: None
            width: dp(40) if root.badge else 0
            halign: 'right'
            valign: 'middle'

<MessageEmbed>:
    size_hint_y: None
    height: dp(200)
    size_hint_x: None
    width: dp(400)
    allow_stretch: False
    keep_ratio: True
    canvas.before:
        Color:
            rgba: app.theme_colors['msg_own']
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), dp(12), dp(12), dp(12)]

<FullScreenImageOverlay>:
    size_hint: 1, 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.85
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        size_hint: 1, 1
        padding: dp(40)
        AsyncImage:
            id: full_image
            source: root.source
            allow_stretch: False
            keep_ratio: True
            size_hint: 1, 1
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        MDButton:
            style: 'filled'
            size_hint_y: None
            height: dp(50)
            size_hint_x: None
            width: dp(150)
            pos_hint: {'center_x': 0.5}
            theme_bg_color: 'Custom'
            md_bg_color: app.theme_colors['primary']
            on_press: root.download_image()
            MDButtonText:
                text: 'Download'
        MDButton:
            style: 'outlined'
            size_hint_y: None
            height: dp(50)
            size_hint_x: None
            width: dp(150)
            pos_hint: {'center_x': 0.5}
            on_press: root.dismiss()
            MDButtonText:
                text: 'Close'

<MemberRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(36)
    padding: [dp(8), 0]
    spacing: dp(8)
    PfpImage:
        id: pfpx
        size_hint: None, None
        size: dp(26), dp(26)
        source: root.avatar_source or ""
        allow_stretch: False
        keep_ratio: True
    ClickableLabel:
        text: root.username
        target_hash: root.author_hash
        color: app.theme_colors['text_muted']
        font_size: sp(13)
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        size_hint_x: 1
        on_press: app.open_profile(root.author_hash, root.username)
    Widget:
        size_hint_x: None
        width: dp(12)
    CanvasWidget:
        id: presence_dot
        size_hint: None, None
        size: dp(10), dp(10)
        color: root.presence_color

<ProfileScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Profile'
            font_size: sp(32)
            bold: True
            color: app.theme_colors['text']
            size_hint_y: None
            height: dp(50)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(200)
            spacing: dp(10)
            Widget:
                size_hint_x: 1
            PfpImage:
                id: profile_pfp
                size_hint: None, None
                size: dp(150), dp(150)
                source: root.target_avatar or ''
                allow_stretch: False
                keep_ratio: True
                canvas.after:
                    Color:
                        rgba: 0, 0, 0, 0.5
                    Ellipse:
                        pos: self.center_x - dp(75), self.center_y - dp(75)
                        size: dp(150), dp(150)
                    Color:
                        rgba: app.theme_colors['text']
                    Line:
                        circle: self.center_x, self.center_y, 75
                        width: 2
            Widget:
                size_hint_x: 1
        Label:
            text: root.target_username
            font_size: sp(20)
            bold: True
            color: app.theme_colors['text']
            size_hint_y: None
            height: dp(30)
            halign: 'center'
            text_size: self.width, None
        MDTextField:
            id: profile_username_input
            text: root.target_username
            mode: 'filled'
            size_hint_y: None
            height: dp(56)
            fill_color_normal: app.theme_colors['input_bg']
            fill_color_focus: app.theme_colors['input_bg_focus']
            text_color_normal: app.theme_colors['text']
            text_color_focus: app.theme_colors['text']
            cursor_color: app.theme_colors['text']
        Label:
            text: 'Node hash: ' + root.target_hash
            font_size: sp(11)
            color: app.theme_colors['text_muted']
            size_hint_y: None
            height: dp(20)
            halign: 'center'
            text_size: self.width, None
            shorten: True
        Label:
            text: 'Delivery: ' + root.target_username
            font_size: sp(11)
            color: app.theme_colors['text_muted']
            size_hint_y: None
            height: dp(20)
            halign: 'center'
            text_size: self.width, None
            shorten: True
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            MDButton:
                style: 'filled'
                size_hint_x: None
                width: dp(140)
                theme_bg_color: 'Custom'
                md_bg_color: app.theme_colors['primary']
                on_press: app.open_file_chooser(avatar=True)
                MDButtonText:
                    text: 'Change Avatar'
                    text_color: app.theme_colors['btn_text']
            MDButton:
                style: 'filled'
                size_hint_x: None
                width: dp(140)
                theme_bg_color: 'Custom'
                md_bg_color: app.theme_colors['primary']
                on_press: app.save_profile()
                MDButtonText:
                    text: 'Save Username'
                    text_color: app.theme_colors['btn_text']
            MDButton:
                style: 'outlined'
                size_hint_x: None
                width: dp(100)
                on_press: app.root.current = 'main'
                MDButtonText:
                    text: 'Back'
                    text_color: app.theme_colors['text']

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(48)
            padding: [dp(8), dp(4)]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: app.theme_colors['topbar']
                Rectangle:
                    pos: self.pos
                    size: self.size
            HamburgerIcon:
                on_press: root.toggle_left()
                color: app.theme_colors['text']
            CtxHeaderLabel:
                id: channel_header
                text: '#' + (root._current_channel or 'general')
                color: app.theme_colors['text']
                bold: True
                font_size: sp(16)
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
            SearchIcon:
                on_press: app.open_search()
                color: app.theme_colors['text']
            GearIcon:
                on_press: app.open_profile(app.my_hash or '', app.username or '')
                color: app.theme_colors['text']
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 1

            # ---------------- far-left: servers (guild list) ---------------
            BoxLayout:
                id: server_sidebar
                size_hint_x: None
                width: dp(64)
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: app.theme_colors['bg_sidebar']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                ScrollView:
                    do_scroll_x: False
                    GridLayout:
                        id: server_grid
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)
                        padding: [dp(4), dp(8)]
                # Add server button at bottom
                MDButton:
                    id: add_server_btn
                    style: 'filled'
                    size_hint_y: None
                    height: dp(48)
                    theme_bg_color: 'Custom'
                    md_bg_color: app.theme_colors['primary']
                    on_press: app._open_add_server_popup()
                    MDButtonText:
                        text: '+'
                        text_color: app.theme_colors['btn_text']
                        font_size: sp(24)

            # ---------------- left: channels (collapsable) ----------------
            BoxLayout:
                id: left_sidebar
                size_hint_x: None
                width: dp(220) if root.left_open else dp(0)
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: app.theme_colors['bg_sidebar']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Image:
                    id: banner_channel
                    source: app.banner_channel_path or ''
                    size_hint_y: None
                    height: dp(160)
                    size_hint_x: None
                    width: dp(200)
                    allow_stretch: False
                    keep_ratio: True
                    pos_hint: {'center_x': 0.5}
                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    padding: [dp(6), dp(2)]
                    Widget:
                        size_hint_x: 1
                    MDButton:
                        style: 'outlined'
                        size_hint_y: None
                        height: dp(32)
                        width: dp(36)
                        theme_bg_color: 'Custom'
                        md_bg_color: app.theme_colors['sidebar_ctrl']
                        on_press: app.open_config()
                        MDButtonText:
                            text: 'cfg'
                            shorten: True
                MDButton:
                    style: 'outlined'
                    size_hint_y: None
                    height: dp(34)
                    theme_bg_color: 'Custom'
                    md_bg_color: app.theme_colors['sidebar_ctrl']
                    on_press: root.toggle_left()
                    MDButtonText:
                        text: 'channels v' if root.left_open else 'channels >'
                ScrollView:
                    do_scroll_x: False
                    GridLayout:
                        id: channel_grid
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                        padding: [dp(6), dp(6)]

            SlimButton:
                text: '<'
                on_press: root.toggle_left()
            # ---------------- center: chat ----------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 1
                canvas.before:
                    Color:
                        rgba: app.theme_colors['panel']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                ScrollView:
                    id: scroll
                    do_scroll_x: False
                    bar_width: dp(6)
                    size_hint_y: 1
                    GridLayout:
                        id: message_grid
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                        padding: [dp(6), dp(6)]
                BoxLayout:
                    size_hint_y: None
                    height: dp(24)
                    padding: [dp(4), dp(1)]
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: app.theme_colors['panel_darker']
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    MDTextField:
                        id: msg_input
                        hint_text: 'Message...'
                        mode: 'filled'
                        multiline: True
                        size_hint_x: 1
                        size_hint_y: None
                        height: self.minimum_height
                        min_height: dp(20)
                        max_height: dp(80)
                        radius: [dp(6), dp(6), dp(6), dp(6)]
                        fill_color_normal: app.theme_colors['input_bg']
                        fill_color_focus: app.theme_colors['input_bg_focus']
                        text_color_normal: app.theme_colors['text']
                        text_color_focus: app.theme_colors['text']
                        cursor_color: app.theme_colors['text']
                        on_text_validate: app.send_message()
                    MDButton:
                        style: 'filled'
                        size_hint_x: None
                        width: dp(40)
                        theme_bg_color: 'Custom'
                        md_bg_color: app.theme_colors['primary']
                        on_press: app.send_message()
                        MDButtonText:
                            text: 'Send'
                            text_color: app.theme_colors['btn_text']
                    Widget:
                        size_hint_x: None
                        width: dp(3)
                    MDButton:
                        style: 'filled'
                        size_hint_x: None
                        width: dp(24)
                        theme_bg_color: 'Custom'
                        md_bg_color: app.theme_colors['primary']
                        on_press: app.open_attach_dialog()
                        MDButtonText:
                            text: '+'
                            text_color: app.theme_colors['btn_text']

            SlimButton:
                text: '>'
                on_press: root.toggle_right()
            # ---------------- right: members (collapsable) ----------------
            BoxLayout:
                id: right_sidebar
                size_hint_x: None
                width: dp(200) if root.right_open else dp(0)
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: app.theme_colors['bg_sidebar']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                MDButton:
                    style: 'outlined'
                    size_hint_y: None
                    height: dp(34)
                    theme_bg_color: 'Custom'
                    md_bg_color: app.theme_colors['sidebar_ctrl']
                    on_press: root.toggle_right()
                    MDButtonText:
                        text: 'members \\u25bc' if root.right_open else 'members \\u25b6'
                ScrollView:
                    do_scroll_x: False
                    GridLayout:
                        id: member_grid
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                        padding: [dp(6), dp(6)]

<ConnectScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(40)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        Image:
            id: banner_config
            source: app.banner_config_path or ''
            size_hint_y: None
            height: dp(200)
            size_hint_x: None
            width: dp(400)
            allow_stretch: False
            keep_ratio: True
        Label:
            text: 'sHades'
            font_size: sp(40)
            bold: True
            color: app.theme_colors['text']
            size_hint_y: None
            height: dp(60)
        Label:
            text: 'Connect to a guild'
            color: app.theme_colors['text_muted']
            size_hint_y: None
            height: dp(30)
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(10)
            size_hint_y: None
            height: dp(340)
            MDTextField:
                id: hub_address
                hint_text: 'Hub address (ip:port, e.g. 192.168.1.50:29221)'
                multiline: False
                size_hint_y: None
                height: dp(44)
                fill_color_normal: app.theme_colors['input_bg']
                fill_color_focus: app.theme_colors['input_bg_focus']
                text_color_normal: app.theme_colors['text']
                text_color_focus: app.theme_colors['text']
                cursor_color: app.theme_colors['text']
            Label:
                text: 'Hub address (ip:port) of the guild hub to connect to'
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                font_size: sp(11)
            MDTextField:
                id: username
                hint_text: 'Your username'
                multiline: False
                size_hint_y: None
                height: dp(44)
                fill_color_normal: app.theme_colors['input_bg']
                fill_color_focus: app.theme_colors['input_bg_focus']
                text_color_normal: app.theme_colors['text']
                text_color_focus: app.theme_colors['text']
                cursor_color: app.theme_colors['text']
            Label:
                text: 'Your display name in the guild'
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                font_size: sp(11)
            Label:
                text: 'Guild hashes (leave blank to auto-discover from hub announce)'
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(20)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                font_size: sp(11)
            MDTextField:
                id: node_hash
                hint_text: 'Guild node_hash (32 hex, optional)'
                multiline: False
                size_hint_y: None
                height: dp(40)
                fill_color_normal: app.theme_colors['input_bg']
                fill_color_focus: app.theme_colors['input_bg_focus']
                text_color_normal: app.theme_colors['text']
                text_color_focus: app.theme_colors['text']
                cursor_color: app.theme_colors['text']
            Label:
                text: 'Node hash of the guild (32 hex, optional)'
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                font_size: sp(11)
            MDTextField:
                id: delivery_hash
                hint_text: 'Guild delivery_hash (32 hex, optional)'
                multiline: False
                size_hint_y: None
                height: dp(40)
                fill_color_normal: app.theme_colors['input_bg']
                fill_color_focus: app.theme_colors['input_bg_focus']
                text_color_normal: app.theme_colors['text']
                text_color_focus: app.theme_colors['text']
                cursor_color: app.theme_colors['text']
            Label:
                text: 'Delivery hash of the guild (32 hex, optional)'
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                font_size: sp(11)
            MDButton:
                style: 'filled'
                size_hint_y: None
                height: dp(50)
                theme_bg_color: 'Custom'
                md_bg_color: app.theme_colors['primary']
                on_press: app.connect_to_guild(hub_address.text, username.text, node_hash.text, delivery_hash.text)
                MDButtonText:
                    text: 'Connect'
                    text_color: app.theme_colors['btn_text']
        Label:
            id: status
            text: ''
            color: app.theme_colors['accent']
            font_size: sp(13)
            size_hint_y: None
            height: dp(30)

<SlimButton@Button>:
    size_hint_x: None
    width: dp(14)
    size_hint_y: 1
    background_color: 0, 0, 0, 0
    color: app.theme_colors['text_muted']
    font_size: sp(17)
    bold: True
    canvas.before:
        Color:
            rgba: app.theme_colors['bg_sidebar']
        Rectangle:
            pos: self.pos
            size: self.size

<ConfigScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Appearance'
            font_size: sp(24)
            bold: True
            color: app.theme_colors['text']
            size_hint_y: None
            height: dp(44)
        ScrollView:
            do_scroll_x: False
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                padding: dp(12)
                spacing: dp(8)
                Label:
                    text: 'Theme colors (hex #RRGGBB)'
                    font_size: sp(16)
                    bold: True
                    color: app.theme_colors['text_muted']
                    size_hint_y: None
                    height: dp(28)
                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    padding: [0, dp(2)]
                    Label:
                        text: 'Background'
                        size_hint_x: 0.34
                        color: app.theme_colors['text']
                    MDTextField:
                        id: c_bg_main
                        text: ''
                        mode: 'filled'
                        size_hint_x: 0.66
                        fill_color_normal: app.theme_colors['input_bg']
                        fill_color_focus: app.theme_colors['input_bg_focus']
                        text_color_normal: app.theme_colors['text']
                        text_color_focus: app.theme_colors['text']
                        cursor_color: app.theme_colors['text']
                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    padding: [0, dp(2)]
                    Label:
                        text: 'Chat area'
                        size_hint_x: 0.34
                        color: app.theme_colors['text']
                    MDTextField:
                        id: c_panel
