        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: dp(12)
            spacing: dp(10)
            MDButton:
                style: 'filled'
                theme_bg_color: 'Custom'
                md_bg_color: app.theme_colors['primary']
                on_press: root.save_config()
                MDButtonText:
                    text: 'Save'
                    text_color: app.theme_colors['btn_text']
            MDButton:
                style: 'outlined'
                on_press: root.reset_config()
                MDButtonText:
                    text: 'Reset'
                    text_color: app.theme_colors['text']
            MDButton:
                style: 'outlined'
                on_press: app.root.current = 'main'
                MDButtonText:
                    text: 'Back'
                    text_color: app.theme_colors['text']